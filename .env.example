# ── 前端 Firebase 設定（直接沿用 GameRank 的同一個 Firebase 專案）──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Vercel Serverless Functions（伺服器端專用，勿加 VITE_ 前綴）──
FIREBASE_PROJECT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=U32ac8f3e19705ed51c36f6b8c7bb2830

# 選填：沿用 GameRank 的 IGDB 金鑰（可提升跨平台遊戲搜尋準確率）
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── GitHub Actions Worker（排程背景腳本用）──
# Firebase Console -> 專案設定 -> 服務帳戶 -> 產生新的私密金鑰 (整段 JSON 貼入 GitHub Secret)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 你的 Firebase Auth UID（登入 PersonalNotify 後可在設定頁一鍵複製）
TARGET_FIREBASE_UID=

# Steam & IsThereAnyDeal（Phase 1）
STEAM_API_KEY=
STEAM_ID=
ITAD_API_KEY=

# Gemini API（Phase 2：台灣北部藝人活動語意過濾與售票時間萃取，可沿用 GameRank 金鑰）
GEMINI_API_KEY=
# 選填，預設 gemini-2.5-flash
GEMINI_MODEL=

# 選填：個人化通知網頁網址（會放在 LINE 卡片的快速連結按鈕）
APP_BASE_URL=

# 選填：本機測試模式，設為 1 時不實際發送 LINE Push 亦不寫回推播狀態
DRY_RUN=0
